import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

def main():
    # --- Extension Task: Allow user to provide the CSV file name ---
    filename = input("Enter the CSV file name (e.g., sample_data_assignment_07.csv): ")
    
    try:
        # Load the CSV dataset
        df = pd.read_csv(filename)
        print("\n--- Dataset ---")
        print(df)
        
        # --- Extension Task: Calculate and display averages ---
        print("\n--- Averages ---")
        print(f"Average Maths Marks: {df['Maths'].mean():.2f}")
        print(f"Average Python Marks: {df['Python'].mean():.2f}")
        print(f"Average Attendance: {df['Attendance'].mean():.2f}")
        print("-" * 30)

        # 1. Line Plot (Python Marks)
        plt.figure(figsize=(8, 5))
        plt.plot(df["Student"], df["Python"], marker="o", color='b', label="Python Marks")
        plt.title("Python Marks of Students")
        plt.xlabel("Student")
        plt.ylabel("Python Marks")
        plt.legend()
        plt.grid(True)
        plt.show()

        # 2. Bar Plot (Maths Marks)
        plt.figure(figsize=(8, 5))
        plt.bar(df["Student"], df["Maths"], color='skyblue', label="Maths Marks")
        plt.title("Maths Marks of Students")
        plt.xlabel("Student")
        plt.ylabel("Maths Marks")
        plt.legend()
        plt.show()

        # 3. Scatter Plot (Maths vs Python)
        plt.figure(figsize=(8, 5))
        plt.scatter(df["Maths"], df["Python"], s=100, color='r', label="Student Data")
        plt.title("Maths vs Python Marks")
        plt.xlabel("Maths Marks")
        plt.ylabel("Python Marks")
        plt.legend()
        plt.grid(True)
        plt.show()

        # 4. Correlation Matrix and Heatmap
        correlation = df[["Maths", "Python", "Attendance"]].corr()
        plt.figure(figsize=(6, 5))
        sns.heatmap(correlation, annot=True, cmap="Blues", vmin=-1, vmax=1)
        plt.title("Correlation Heatmap")
        plt.show()

        # --- EXTENSION TASKS VISUALIZATIONS ---

        # 5. Histogram of Python Marks
        plt.figure(figsize=(8, 5))
        plt.hist(df["Python"], bins=5, color='purple', edgecolor='black')
        plt.title("Distribution of Python Marks")
        plt.xlabel("Python Marks")
        plt.ylabel("Frequency")
        plt.show()

        # 6. Box Plot for Maths and Python Marks
        plt.figure(figsize=(8, 5))
        sns.boxplot(data=df[["Maths", "Python"]], palette="Set2")
        plt.title("Box Plot of Maths and Python Marks")
        plt.ylabel("Marks")
        plt.show()

        # 7. Pie Chart for Students per City
        plt.figure(figsize=(7, 7))
        city_counts = df["City"].value_counts()
        plt.pie(city_counts, labels=city_counts.index, autopct='%1.1f%%', startangle=140, colors=sns.color_palette("pastel"))
        plt.title("Distribution of Students by City")
        plt.show()

    except FileNotFoundError:
        print(f"Error: The file '{filename}' was not found. Please ensure the file exists in the same directory.")

if __name__ == "__main__":
    main()