
matrix_a = [
    [1, 2, 3],
    [4, 5, 6],
    [7, 8, 9]
]

matrix_b = [
    [9, 8, 7],
    [6, 5, 4],
    [3, 2, 1]
]


rows = len(matrix_a)
cols = len(matrix_a[0])
result = [[0 for _ in range(cols)] for _ in range(rows)]


for i in range(rows):
    for j in range(cols):
        result[i][j] = matrix_a[i][j] + matrix_b[i][j]

# Display the output
print("Matrix A:")
for row in matrix_a:
    print(row)

print("\nMatrix B:")
for row in matrix_b:
    print(row)

print("\nResultant Matrix (Addition):")
for row in result:
    print(row)