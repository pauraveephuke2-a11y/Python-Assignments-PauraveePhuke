def is_right_triangle(a, b, c):
    sides = [a, b, c]
    sides.sort()

    if sides[0] ** 2 + sides[1] ** 2 == sides[2] ** 2:
        return True
    return False



a = 3
b = 4
c = 5

if is_right_triangle(a, b, c):
    print("It is a right-angled triangle.")
else:
    print("It is not a right-angled triangle.")